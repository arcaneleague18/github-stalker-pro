# LLM API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="openai/model"

# GitHub Personal Access Token (Required for GitHub API & MCP Server)
# Create a token with 'repo', 'read:user', and 'read:org' scopes at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# GitHub MCP Server Configuration
# Command to run the GitHub MCP stdio server (defaults to npx if node is installed)
# Examples:
#   npx -y @modelcontextprotocol/server-github
#   docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN mcp/github
MCP_SERVER_COMMAND="npx -y @modelcontextprotocol/server-github"

# Application Settings
LOG_LEVEL=INFO
APP_TITLE="GitHub Insight AI"
